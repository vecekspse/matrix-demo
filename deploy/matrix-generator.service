# Generovani animaci na pozadi (generator/loop.py). Bezi jako bezny uzivatel,
# klice a backend bere z .env v adresari projektu.
# Uprav User a cestu podle Pi.
#   sudo cp deploy/matrix-generator.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now matrix-generator
[Unit]
Description=LED matrix animation generator
Wants=network-online.target
After=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/matrix-demo
ExecStart=/home/pi/matrix-demo/.venv/bin/python -m generator.loop
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
