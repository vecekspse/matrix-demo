# Zkopiruj do .env (je v .gitignore) a doplň hodnoty. Do gitu klíče nepatří.

# Výchozí backend, když se nezadá --backend: anthropic | openai
GENERATOR_BACKEND=

# Anthropic (--backend anthropic)
ANTHROPIC_API_KEY=

# Náš AI stroj, OpenAI-kompatibilní API (--backend openai)
OPENAI_BASE_URL=https://ai-stroj.example/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# Volitelně: JSON přidaný do každého požadavku. Qwen3 bez přemýšlení (rychlejší, nevyčerpá max_tokens):
# OPENAI_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
OPENAI_EXTRA_BODY=
